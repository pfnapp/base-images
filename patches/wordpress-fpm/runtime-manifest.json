{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "runtime": "wordpress-fpm",
  "framework": "WordPress",
  "version": "7.1.1-php8.3-fpm-alpine",
  "baseImage": "ghcr.io/pfnapp/wordpress-fpm:7.1.1-php8.3-fpm-alpine",
  "ports": { "default": 9000, "protocol": "TCP" },
  "security": { "runAsUser": 0, "runAsGroup": 0, "readOnlyRoot": false },
  "probes": { "liveness": { "path": "/", "port": 80 }, "readiness": { "path": "/", "port": 80 } },
  "tunables": [
    { "key": "WORDPRESS_DB_HOST", "label": "Database Host", "type": "string", "required": true, "example": "db:3306", "safe": true, "category": "database", "description": "MariaDB/MySQL host and port." },
    { "key": "WORDPRESS_DB_USER", "label": "Database User", "type": "string", "required": true, "example": "wordpress", "safe": true, "category": "database", "description": "Database username." },
    { "key": "WORDPRESS_DB_PASSWORD", "label": "Database Password", "type": "string", "required": true, "example": "local-only-wp-db-pass", "safe": true, "category": "database", "description": "Database password." },
    { "key": "WORDPRESS_DB_NAME", "label": "Database Name", "type": "string", "required": false, "default": "wordpress", "example": "wordpress", "safe": true, "category": "database", "description": "Database name." },
    { "key": "WORDPRESS_TABLE_PREFIX", "label": "Database Table Prefix", "type": "string", "required": false, "default": "wp_", "example": "wp_", "safe": true, "category": "database", "description": "Custom table prefix for WordPress database tables." },
    { "key": "WORDPRESS_DEBUG", "label": "Enable WP_DEBUG", "type": "boolean", "required": false, "default": false, "example": true, "safe": true, "category": "runtime", "description": "Enables WordPress runtime debugging mode." },
    { "key": "WORDPRESS_CONFIG_EXTRA", "label": "Extra WordPress Config", "type": "string", "required": false, "example": "define('WP_ENVIRONMENT_TYPE', 'local');", "safe": true, "category": "runtime", "description": "Raw PHP directives injected into wp-config.php on container startup." }
  ]
}
