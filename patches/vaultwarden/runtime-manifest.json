{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "runtime": "vaultwarden",
  "framework": "Vaultwarden",
  "version": "1.37.3",
  "baseImage": "ghcr.io/pfnapp/vaultwarden:1.37.3",
  "ports": { "default": 80, "protocol": "HTTP" },
  "security": { "runAsUser": 0, "runAsGroup": 0, "readOnlyRoot": false },
  "probes": { "liveness": { "path": "/alive", "port": 80 }, "readiness": { "path": "/alive", "port": 80 } },
  "tunables": [
    { "key": "DOMAIN", "label": "Public Domain", "type": "string", "required": false, "example": "http://localhost:8084", "safe": true, "category": "networking", "description": "Public URL used in generated invitation links and emergency access." },
    { "key": "SIGNUPS_ALLOWED", "label": "Allow Signups", "type": "boolean", "required": false, "default": true, "example": false, "safe": true, "category": "security", "description": "Whether open registration is allowed without prior invitations." },
    { "key": "INVITATIONS_ALLOWED", "label": "Allow Invitations", "type": "boolean", "required": false, "default": true, "example": true, "safe": true, "category": "security", "description": "Allow organization members to invite new users even if signups are disabled." },
    { "key": "WEBSOCKET_ENABLED", "label": "WebSocket Enabled", "type": "boolean", "required": false, "default": false, "example": true, "safe": true, "category": "networking", "description": "Enables real-time push synchronization across devices." },
    { "key": "ADMIN_TOKEN", "label": "Admin Token", "type": "string", "required": false, "example": "local-only-admin-token", "safe": true, "category": "security", "description": "Bearer token or Argon2 hash for `/admin` management page access." },
    { "key": "DATABASE_URL", "label": "Database URL", "type": "string", "required": false, "default": "data/db.sqlite3", "example": "data/db.sqlite3", "safe": true, "category": "database", "description": "SQLite file path or PostgreSQL/MySQL connection string." },
    { "key": "SMTP_HOST", "label": "SMTP Host", "type": "string", "required": false, "example": "smtp.example.com", "safe": true, "category": "notifications", "description": "Outgoing SMTP server hostname." },
    { "key": "SMTP_PORT", "label": "SMTP Port", "type": "number", "required": false, "default": 587, "example": 587, "safe": true, "category": "notifications", "description": "Outgoing SMTP server port." },
    { "key": "SMTP_FROM", "label": "SMTP From Address", "type": "string", "required": false, "example": "vaultwarden@example.com", "safe": true, "category": "notifications", "description": "Sender email address for system emails." },
    { "key": "SMTP_USERNAME", "label": "SMTP Username", "type": "string", "required": false, "example": "vaultwarden@example.com", "safe": true, "category": "notifications", "description": "SMTP authentication username." },
    { "key": "SMTP_PASSWORD", "label": "SMTP Password", "type": "string", "required": false, "example": "local-only-smtp-password", "safe": true, "category": "notifications", "description": "SMTP authentication password." },
    { "key": "SMTP_SECURITY", "label": "SMTP Security", "type": "string", "required": false, "default": "starttls", "example": "starttls", "safe": true, "category": "notifications", "description": "Encryption mode (`starttls`, `force_tls`, `off`)." }
  ]
}
