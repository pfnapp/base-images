# Example environment for docker-compose.yml.
#
# Copy to `.env` next to docker-compose.yml (git-ignored) and edit there:
#
#   cp .env.example .env
#
# docker compose reads `.env` for the ${...} interpolation in
# docker-compose.yml only; nothing in it is baked into the image.
# No real credentials are stored in this repository — every value below is a
# placeholder for local validation.
#
# Sample defaults (running with NO `.env` at all) are dashboard-first:
#   * web dashboard on 127.0.0.1:9119 behind the placeholder basic-auth pair,
#   * OpenAI-compatible API server (8642) pinned OFF at boot and NOT published,
#   * container healthcheck = dashboard availability probe.

# --- API server (port 8642) — OPTIONAL, off and unpublished by default -----
# The compose boot prelude runs
#   hermes config set platforms.api_server.enabled false
# on every start while this is false, so nothing listens on 8642 — the flag
# alone would not be enough: the gateway gates that adapter on a usable
# API_SERVER_KEY, and the image's stage2 hook generates one (per data volume,
# 0600, never committed) so upstream's loopback control plane would otherwise
# start. Dashboard-internal cron is unaffected (the gateway runs its own
# ticker); only the optional external Chronos/NAS cron-fire callback and
# relay-fronted manual runs need it.
#
# To opt in (local validation only — generate, never commit, real values):
#   API_SERVER_ENABLED=true                 # prelude stops pinning it off
#   HERMES_API_SERVER_KEY=$(openssl rand -hex 32)   # optional: pin your own;
#                                           # otherwise stage2's generated key
#                                           # is used
#   HERMES_API_SERVER_HOST=0.0.0.0          # upstream defaults to 127.0.0.1,
#                                           # which keeps a published port dead
# and uncomment the `- "127.0.0.1:8642:8642"` line under `ports:` in
# docker-compose.yml, then `docker compose up -d`. Verify with
# `curl -fsS http://127.0.0.1:8642/health` and
# `Authorization: Bearer <your key>` on /v1. Set back to false and restart to
# pin it off again.
API_SERVER_ENABLED=false
HERMES_API_SERVER_KEY=
HERMES_API_SERVER_HOST=127.0.0.1

# --- Web dashboard (port 9119, published on 127.0.0.1 by default) ----------
# The dashboard only starts when truthy; the container binds 0.0.0.0, so
# upstream's auth gate requires an auth provider (basic auth below, or OAuth).
# Use 0 to keep the s6 dashboard service down — note the container healthcheck
# probes the dashboard, so it can never report healthy while the dashboard is
# off.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-me-dashboard-password
# Optional but recommended: keeps dashboard sessions alive across restarts.
# Generate with `openssl rand -base64 32`. Empty = new key on every start.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
