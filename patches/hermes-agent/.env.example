# Example environment for docker-compose.yml.
#
# Copy to `.env` next to docker-compose.yml (git-ignored) and edit there:
#
#   cp .env.example .env
#
# docker compose reads `.env` for the ${...} interpolation in
# docker-compose.yml only; nothing in it is baked into the image.
# No real credentials are stored in this repository — every value below is a
# placeholder for local validation.

# --- API server (port 8642) -------------------------------------------------
# Bearer token for the OpenAI-compatible API server. Upstream refuses to start
# the adapter with fewer than 16 characters.
HERMES_API_SERVER_KEY=replace-me-api-server-key

# --- Web dashboard (port 9119, published on 127.0.0.1 by default) ----------
# The dashboard only starts when truthy; the container binds 0.0.0.0, so
# upstream's auth gate requires an auth provider (basic auth below, or OAuth).
# Use 0 to keep the s6 dashboard service down.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-me-dashboard-password
# Optional but recommended: keeps dashboard sessions alive across restarts.
# Generate with `openssl rand -base64 32`. Empty = new key on every start.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
