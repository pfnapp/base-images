{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "runtime": "memos",
  "framework": "Memos",
  "version": "0.31.0",
  "baseImage": "ghcr.io/pfnapp/memos:0.31.0",
  "ports": { "default": 5230, "protocol": "HTTP" },
  "security": { "runAsUser": 0, "runAsGroup": 0, "readOnlyRoot": false },
  "probes": { "liveness": { "path": "/", "port": 5230 }, "readiness": { "path": "/", "port": 5230 } },
  "tunables": [
    { "key": "MEMOS_MODE", "label": "Run Mode", "type": "string", "required": false, "default": "prod", "example": "prod", "safe": true, "category": "runtime", "description": "Memos runtime mode (`dev` or `prod`)." },
    { "key": "MEMOS_PORT", "label": "Server Port", "type": "number", "required": false, "default": 5230, "example": 5230, "safe": true, "category": "networking", "description": "Memos HTTP listening port." },
    { "key": "MEMOS_DATA", "label": "Data Directory", "type": "string", "required": false, "default": "/var/opt/memos", "example": "/var/opt/memos", "safe": true, "category": "storage", "description": "Memos persistent SQLite and assets directory." },
    { "key": "MEMOS_DRIVER", "label": "Database Driver", "type": "string", "required": false, "default": "sqlite", "example": "sqlite", "safe": true, "category": "database", "description": "Database engine (`sqlite`, `mysql`, `postgres`)." },
    { "key": "MEMOS_DSN", "label": "Database Connection DSN", "type": "string", "required": false, "example": "user:pass@tcp(db:3306)/memos", "safe": true, "category": "database", "description": "Connection string when using external MySQL or PostgreSQL." },
    { "key": "MEMOS_PUBLIC", "label": "Allow Public Access", "type": "boolean", "required": false, "default": true, "example": true, "safe": true, "category": "security", "description": "Allow public read access without logging in." },
    { "key": "MEMOS_MAX_UPLOAD_SIZE_MIB", "label": "Max Upload Size (MiB)", "type": "number", "required": false, "default": 32, "example": 32, "safe": true, "category": "performance", "description": "Maximum allowed attachment upload size in megabytes." }
  ]
}
