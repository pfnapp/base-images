# Syntax: docker/dockerfile:1
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-alpine

# Set build arguments for non-root runtime UID/GID
ARG UID=10001
ARG GID=10001

# Install runtime utilities, process reaper, and security certificates
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    dumb-init \
    curl \
    ca-certificates \
    tzdata

# Upgrade npm to latest patched version compatible with this Node major.
# npm major compatibility:
#   npm@10  → Node 18  (npm 11+ requires Node >= 20)
#   npm@11  → Node 20  (npm 12+ requires Node >= 22.22.2 | 24.15.0 | 26.0.0)
#   npm@latest (12+) → Node 22 / 24 / 26
# Version tag resolved at build time so one Dockerfile covers all versions.
RUN node -e "const v=parseInt(process.version.slice(1)); \
  process.stdout.write(v<=18?'10':v<=20?'11':'latest')" \
  | xargs -I{} npm install -g npm@{}

# Create dedicated non-root user and group
RUN addgroup -g ${GID} -S appgroup && \
    adduser -u ${UID} -S appuser -G appgroup

# Pre-create application root directory with non-root ownership
RUN mkdir -p /app && \
    chown -R ${UID}:${GID} /app

# Copy unified runtime entrypoint
COPY shared/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    chown ${UID}:${GID} /usr/local/bin/entrypoint.sh

WORKDIR /app

# Drop SUID/SGID permissions to eliminate local privilege escalation paths
RUN find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

# Default unprivileged networking and environment
ENV PORT=8080 \
    HOSTNAME=0.0.0.0 \
    NODE_ENV=production

EXPOSE 8080

USER 10001:10001

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/local/bin/entrypoint.sh"]
