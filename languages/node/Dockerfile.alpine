# Syntax: docker/dockerfile:1
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-alpine

# Set build arguments for non-root runtime UID/GID
ARG UID=10001
ARG GID=10001

# Install runtime utilities, process reaper, and security certificates
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    dumb-init \
    curl \
    ca-certificates \
    tzdata

# Upgrade npm to latest patched version.
# Node 18 ships with npm 10.8.2 which bundles vulnerable transitive deps
# (tar 6.2.1, brace-expansion 2.0.1, minimatch 9.0.5, etc.).
# npm 11+ requires Node >= 20, so we pin npm@10 for Node 18 and use npm@latest
# for Node 20+. The version is resolved at build time via node itself.
RUN npm install -g npm@$(node -e "const v=parseInt(process.version.slice(1)); console.log(v>=20?'latest':'10')")

# Create dedicated non-root user and group
RUN addgroup -g ${GID} -S appgroup && \
    adduser -u ${UID} -S appuser -G appgroup

# Pre-create application root directory with non-root ownership
RUN mkdir -p /app && \
    chown -R ${UID}:${GID} /app

# Copy unified runtime entrypoint
COPY shared/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    chown ${UID}:${GID} /usr/local/bin/entrypoint.sh

WORKDIR /app

# Drop SUID/SGID permissions to eliminate local privilege escalation paths
RUN find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

# Default unprivileged networking and environment
ENV PORT=8080 \
    HOSTNAME=0.0.0.0 \
    NODE_ENV=production

EXPOSE 8080

USER 10001:10001

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/local/bin/entrypoint.sh"]
