# Syntax: docker/dockerfile:1
FROM python:3.12-slim-bookworm

# Set build arguments for non-root runtime UID/GID
ARG UID=10001
ARG GID=10001

# Configure non-interactive Debian and Python environment defaults
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PORT=8080 \
    HOSTNAME=0.0.0.0

# Install runtime utilities, process supervisor, and security certificates
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    dumb-init \
    curl \
    ca-certificates \
    tzdata && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Upgrade core packaging toolchain
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Create dedicated non-root user and group
RUN groupadd -g ${GID} appgroup && \
    useradd -u ${UID} -g appgroup -s /bin/bash -m appuser

# Pre-create application root directory with non-root ownership
RUN mkdir -p /app && \
    chown -R ${UID}:${GID} /app

# Copy unified runtime entrypoint
COPY shared/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    chown ${UID}:${GID} /usr/local/bin/entrypoint.sh

WORKDIR /app

# Drop SUID/SGID permissions to eliminate local privilege escalation paths
RUN find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

EXPOSE 8080

USER 10001:10001

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/local/bin/entrypoint.sh"]
