# Syntax: docker/dockerfile:1
FROM mlocati/php-extension-installer:latest AS extension-installer

FROM php:8.4-fpm-alpine

# Set build arguments for non-root runtime UID/GID
ARG UID=10001
ARG GID=10001

# Install runtime utilities, web server, and process supervisor
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    nginx \
    supervisor \
    curl \
    ca-certificates \
    tzdata

# Install PHP extensions using official installer
COPY --from=extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions \
    pdo_mysql \
    zip \
    gd \
    intl \
    bcmath \
    opcache \
    redis

# Create dedicated non-root user and group
RUN addgroup -g ${GID} -S appgroup && \
    adduser -u ${UID} -S appuser -G appgroup

# Remove default PHP-FPM pool configs to prevent port or user conflicts
RUN rm -rf /usr/local/etc/php-fpm.d/*

# Pre-create all required directories with non-root ownership
RUN mkdir -p \
    /etc/php/conf.d/custom \
    /etc/nginx/conf.d/custom \
    /tmp/nginx/client_temp \
    /tmp/nginx/proxy_temp \
    /tmp/nginx/fastcgi_temp \
    /tmp/nginx/uwsgi_temp \
    /tmp/nginx/scgi_temp \
    /var/www/html/public \
    /var/log/nginx \
    /var/lib/nginx \
    /var/log/supervisor \
    /etc/supervisor && \
    chown -R ${UID}:${GID} \
    /etc/php/conf.d \
    /etc/nginx \
    /tmp/nginx \
    /var/www \
    /var/log/nginx \
    /var/lib/nginx \
    /var/log/supervisor \
    /etc/supervisor && \
    chmod -R 775 /tmp/nginx /var/log/nginx /var/lib/nginx

# Symlink custom PHP conf.d to ensure runtime overrides are loaded
ENV PHP_INI_SCAN_DIR=":/etc/php/conf.d/custom"
RUN ln -sf /etc/php/conf.d/custom /usr/local/etc/php/conf.d/custom

# Copy unified shared configurations
COPY shared/nginx/nginx.conf /etc/nginx/nginx.conf
COPY shared/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY shared/nginx/proxy.conf /etc/nginx/conf.d/proxy.conf
COPY shared/php.ini /usr/local/etc/php/php.ini
COPY shared/php-fpm.conf /usr/local/etc/php-fpm.conf
COPY shared/supervisord.conf /etc/supervisor/supervisord.conf
COPY shared/entrypoint.sh /usr/local/bin/entrypoint.sh

# Ensure entrypoint is executable and owned by appuser
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    chown -R ${UID}:${GID} /etc/nginx /usr/local/etc/php /etc/supervisor

WORKDIR /var/www/html

# Drop SUID/SGID permissions to eliminate local privilege escalation paths
RUN find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

EXPOSE 8080

USER 10001:10001

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
