{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "runtime": "bun",
  "framework": "Bun",
  "version": "1.4",
  "baseImage": "ghcr.io/pfnapp/base/languages/bun:1.4-alpine",
  "ports": {
    "default": 8080,
    "protocol": "HTTP"
  },
  "security": {
    "runAsUser": 10001,
    "runAsGroup": 10001,
    "readOnlyRoot": false
  },
  "probes": {
    "liveness": { "path": "/", "port": 8080 },
    "readiness": { "path": "/", "port": 8080 }
  },
  "tunables": [
    {
      "key": "PORT",
      "label": "Server Port",
      "type": "number",
      "default": 8080,
      "category": "networking",
      "description": "Internal container listening port.",
      "troubleshooting": "Platform Bun base image listens on unprivileged port 8080."
    },
    {
      "key": "BUN_ENV",
      "label": "Bun Environment",
      "type": "string",
      "default": "production",
      "category": "runtime",
      "description": "Bun execution environment mode.",
      "troubleshooting": "Set to 'production' for optimized Bun runtime performance."
    },
    {
      "key": "NODE_ENV",
      "label": "Node Environment",
      "type": "string",
      "default": "production",
      "category": "runtime",
      "description": "Node.js compatibility environment mode.",
      "troubleshooting": "Set to 'production' for compatible Node.js libraries running under Bun."
    }
  ]
}
