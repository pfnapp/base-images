# Syntax: docker/dockerfile:1
#
# CVE POSTURE (validated with Aqua Trivy):
#   * system (os-pkgs): 0 CRITICAL / 0 HIGH — guaranteed by the `apk upgrade`
#     below; re-run `make build-go && make scan-go` (or rebuild in CI) so the
#     OS floor moves up with every Alpine advisory.
#   * app (gobinary):   0 CRITICAL / 0 HIGH — the golang:<minor>-alpine tag
#     floats to the newest x.y.z patch, which carries the Go stdlib security
#     fixes (stdlib CVEs such as CVE-2026-33818 are only fixed in the toolchain,
#     never in OS packages — downstream apps MUST build with this image as the
#     builder stage, see README.md).
ARG GO_VERSION=1.27
FROM golang:${GO_VERSION}-alpine

# Set build arguments for non-root runtime UID/GID
ARG UID=10001
ARG GID=10001

# Install runtime utilities, process reaper, and security certificates
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    dumb-init \
    curl \
    ca-certificates \
    tzdata

# Create dedicated non-root user and group
RUN addgroup -g ${GID} -S appgroup && \
    adduser -u ${UID} -S appuser -G appgroup

# Pre-create application root directory and Go cache dirs with non-root ownership
RUN mkdir -p /app /tmp/go /tmp/go-cache && \
    chown -R ${UID}:${GID} /app /tmp/go /tmp/go-cache

# Copy unified runtime entrypoint
COPY shared/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    chown ${UID}:${GID} /usr/local/bin/entrypoint.sh

WORKDIR /app

# Drop SUID/SGID permissions to eliminate local privilege escalation paths
RUN find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

# Default unprivileged networking and environment
ENV PORT=8080 \
    HOSTNAME=0.0.0.0 \
    GOPATH=/tmp/go \
    GOCACHE=/tmp/go-cache \
    CGO_ENABLED=0

EXPOSE 8080

USER 10001:10001

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/local/bin/entrypoint.sh"]
