# syntax=docker/dockerfile:1
ARG BUN_VERSION=1.4

# ==============================================================================
# Platform-Managed Vite Dockerfile (Bun Engine + Nginx SPA Runner)
# ==============================================================================
# Managed by the platform / PaaS (App Hosting engine).
# High-speed Vite asset compilation powered by Bun.
# Built 100% unprivileged (UID 10001 / GID 10001) on Alpine Linux.
# ==============================================================================

# Stage 1: Dependency Installation & Vite Build with Bun
FROM oven/bun:${BUN_VERSION}-alpine AS builder

WORKDIR /app

ENV NODE_ENV=production

# Install dependencies using Bun
COPY package.json bun.lockb* bun.lock* ./
RUN bun install --frozen-lockfile 2>/dev/null || bun install

# Copy full application source code
COPY . .

# Build Vite static assets
RUN bun run build

# Stage 2: Hardened Unprivileged Nginx SPA Runner
FROM ghcr.io/pfnapp/base/frameworks/vite:latest

WORKDIR /app

# Copy built static assets from builder stage
COPY --from=builder --chown=10001:10001 /app/dist /app

# Unprivileged HTTP port
EXPOSE 8080

# Enforce non-root execution (UID 10001 / GID 10001)
USER 10001:10001
