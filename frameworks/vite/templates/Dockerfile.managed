# syntax=docker/dockerfile:1
ARG NODE_VERSION=22

# ==============================================================================
# Platform-Managed Vite Dockerfile (Node.js Engine + Nginx SPA Runner)
# ==============================================================================
# Managed by the platform / PaaS (App Hosting engine).
# Developers NEVER create or maintain a Dockerfile in their Vite repository.
# Built 100% unprivileged (UID 10001 / GID 10001) on Alpine Linux.
# Produces an ultra-fast, hardened Nginx static container.
# ==============================================================================

# Stage 1: Dependency Installation & Vite Build
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

ENV NODE_ENV=production

# Install dependencies based on available lockfile
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./
RUN \
  if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm i --frozen-lockfile; \
  elif [ -f yarn.lock ]; then corepack enable && yarn --frozen-lockfile; \
  elif [ -f package-lock.json ]; then npm ci; \
  else npm i; \
  fi

# Copy full application source code
COPY . .

# Build Vite static assets
RUN \
  if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm run build; \
  elif [ -f yarn.lock ]; then corepack enable && yarn run build; \
  else npm run build; \
  fi

# Stage 2: Hardened Unprivileged Nginx SPA Runner
FROM ghcr.io/pfnapp/base/frameworks/vite:latest

WORKDIR /app

# Copy built static assets from builder stage
COPY --from=builder --chown=10001:10001 /app/dist /app

# Unprivileged HTTP port
EXPOSE 8080

# Enforce non-root execution (UID 10001 / GID 10001)
USER 10001:10001
