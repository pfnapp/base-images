# syntax=docker/dockerfile:1
ARG NODE_VERSION=22

# ==============================================================================
# Platform-Managed NestJS Dockerfile (Node.js Engine)
# ==============================================================================
# Managed by the platform / PaaS (App Hosting engine).
# Developers NEVER create or maintain a Dockerfile in their NestJS repository.
# Built 100% unprivileged (UID 10001 / GID 10001) on Alpine Linux.
# Produces an optimized enterprise NestJS runtime container.
# ==============================================================================

# Stage 1: Dependency Installation & NestJS Compilation
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

ENV NODE_ENV=development

# Install dependencies based on available lockfile
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./
RUN \
  if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm i --frozen-lockfile; \
  elif [ -f yarn.lock ]; then corepack enable && yarn --frozen-lockfile; \
  elif [ -f package-lock.json ]; then npm ci; \
  else npm i; \
  fi

# Copy full application source code
COPY . .

# Run requirements script if defined
RUN if npm run --silent requirements 2>/dev/null; then \
        echo "Requirements script found, running requirements..."; \
        npm run requirements; \
    fi

# Build NestJS application (compiles TypeScript to dist/)
RUN \
  if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm run build; \
  elif [ -f yarn.lock ]; then corepack enable && yarn run build; \
  else npm run build; \
  fi

# Stage 2: Hardened Unprivileged NestJS Runtime
FROM ghcr.io/pfnapp/base/frameworks/nestjs:${NODE_VERSION}-alpine

WORKDIR /app

ENV NODE_ENV=production

# Copy package manifests for production dependencies
COPY --chown=10001:10001 package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./

# Install strictly production dependencies (omit devDependencies)
RUN \
  if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm i --prod --frozen-lockfile; \
  elif [ -f yarn.lock ]; then corepack enable && yarn --production --frozen-lockfile; \
  elif [ -f package-lock.json ]; then npm ci --omit=dev; \
  else npm i --omit=dev; \
  fi

# Copy compiled dist folder from builder stage
COPY --from=builder --chown=10001:10001 /app/dist ./dist

# Unprivileged HTTP port
EXPOSE 8080

# Enforce non-root execution (UID 10001 / GID 10001)
USER 10001:10001

CMD ["npm", "run", "start:prod"]
