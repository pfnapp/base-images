# syntax=docker/dockerfile:1
ARG BUN_VERSION=1.4

# ==============================================================================
# Platform-Managed NestJS Dockerfile (Bun Engine)
# ==============================================================================
# Managed by the platform / PaaS (App Hosting engine).
# Ultra-fast NestJS compilation and runtime execution powered by Bun.
# Built 100% unprivileged (UID 10001 / GID 10001) on Alpine Linux.
# ==============================================================================

# Stage 1: Dependency Installation & NestJS Compilation with Bun
FROM oven/bun:${BUN_VERSION}-alpine AS builder

WORKDIR /app

ENV NODE_ENV=development

# Install dependencies using Bun
COPY package.json bun.lockb* bun.lock* ./
RUN bun install --frozen-lockfile 2>/dev/null || bun install

# Copy full application source code
COPY . .

# Run requirements script if defined
RUN if bun run --silent requirements 2>/dev/null; then \
        echo "Requirements script found, running requirements..."; \
        bun run requirements; \
    fi

# Build NestJS application
RUN bun run build

# Stage 2: Hardened Unprivileged Bun Runtime
FROM ghcr.io/pfnapp/base/languages/bun:${BUN_VERSION}-alpine

WORKDIR /app

ENV NODE_ENV=production

# Copy package manifests for production dependencies
COPY --chown=10001:10001 package.json bun.lockb* bun.lock* ./

# Install strictly production dependencies
RUN bun install --production --frozen-lockfile 2>/dev/null || bun install --production

# Copy compiled dist folder from builder stage
COPY --from=builder --chown=10001:10001 /app/dist ./dist

# Unprivileged HTTP port
EXPOSE 8080

# Enforce non-root execution (UID 10001 / GID 10001)
USER 10001:10001

CMD ["bun", "run", "start:prod"]
