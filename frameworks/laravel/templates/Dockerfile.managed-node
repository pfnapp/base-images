# syntax=docker/dockerfile:1
ARG PHP_VERSION=8.4
ARG NODE_VERSION=22

# ==============================================================================
# Platform-Managed Laravel Dockerfile (Fullstack with Node.js / Vite / Inertia)
# ==============================================================================
# Managed by the platform / PaaS (App Hosting engine / Jenkins).
# Developers NEVER create or maintain a Dockerfile in their Laravel repository.
# Built 100% unprivileged (UID 10001 / GID 10001) on Alpine Linux.
# ==============================================================================

# ==============================================================================
# Stage 1: PHP Dependencies Cache
# ==============================================================================
FROM ghcr.io/pfnapp/base/frameworks/laravel:${PHP_VERSION}-alpine AS php-deps

WORKDIR /var/www/html

# Cache Composer dependencies
COPY --chown=10001:10001 composer.json composer.lock* ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-scripts \
    --no-autoloader

# ==============================================================================
# Stage 2: Node.js Frontend Asset Builder (Vite / Tailwind / Inertia / Vue / React)
# ==============================================================================
FROM node:${NODE_VERSION}-alpine AS node-builder

WORKDIR /app

# Cache package dependencies
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./
RUN if [ -f package-lock.json ]; then npm ci --prefer-offline --no-audit; \
    elif [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
    elif [ -f pnpm-lock.yaml ]; then corepack enable && pnpm install --frozen-lockfile; \
    else npm install; fi

# Copy application source code
COPY . .

# Copy PHP vendor directory (needed by Tailwind/Vite to scan Blade/Inertia component paths)
COPY --from=php-deps /var/www/html/vendor /app/vendor

# Compile production frontend assets into /app/public/build
RUN npm run build

# ==============================================================================
# Stage 3: Production Application Runtime (Hardened Non-Root Laravel)
# ==============================================================================
FROM php-deps

WORKDIR /var/www/html

# Copy full application source code with non-root ownership
COPY --chown=10001:10001 . /var/www/html

# Copy compiled frontend assets from Stage 2 node-builder
COPY --from=node-builder --chown=10001:10001 /app/public/build /var/www/html/public/build

# Complete Composer autoloader optimization
RUN composer dump-autoload --optimize --no-dev

# Unprivileged HTTP port
EXPOSE 8080

# Enforce non-root execution (UID 10001 / GID 10001)
USER 10001:10001
