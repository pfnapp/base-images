# syntax=docker/dockerfile:1

# ==============================================================================
# Platform-Managed Next.js Dockerfile (Bun Engine)
# ==============================================================================
# Managed by the platform / PaaS (App Hosting engine).
# High-performance Next.js builds and execution powered by Bun.
# Built 100% unprivileged (UID 10001 / GID 10001) on Alpine Linux.
# ==============================================================================

# Stage 1: Dependency Installation & Next.js Build with Bun
FROM oven/bun:1.2-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

# Install dependencies using Bun
COPY package.json bun.lockb* bun.lock* ./
RUN bun install --frozen-lockfile 2>/dev/null || bun install

# Copy full application source code
COPY . .

# Ensure public directory exists to prevent copy failure in Stage 2
RUN mkdir -p public

# Build Next.js standalone bundle
RUN bun run build

# Stage 2: Hardened Unprivileged Bun Runner
FROM ghcr.io/pfnapp/base/languages/bun:1.2-alpine

WORKDIR /app

# Copy Next.js standalone output and assets with non-root ownership (UID 10001 / GID 10001)
COPY --from=builder --chown=10001:10001 /app/.next/standalone ./
COPY --from=builder --chown=10001:10001 /app/.next/static ./.next/static
COPY --from=builder --chown=10001:10001 /app/public ./public

# Unprivileged HTTP port
EXPOSE 8080

# Enforce non-root execution (UID 10001 / GID 10001)
USER 10001:10001

CMD ["bun", "server.js"]
