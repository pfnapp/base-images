# syntax=docker/dockerfile:1
ARG NODE_VERSION=22

# ==============================================================================
# Platform-Managed Next.js Dockerfile (Node.js Engine)
# ==============================================================================
# Managed by the platform / PaaS (App Hosting engine).
# Developers NEVER create or maintain a Dockerfile in their Next.js repository.
# Built 100% unprivileged (UID 10001 / GID 10001) on Alpine Linux.
# Produces an optimized Next.js standalone runner container.
# ==============================================================================

# Stage 1: Dependency Installation & Next.js Build
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

# Install dependencies based on available lockfile
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./
RUN \
  if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm i --frozen-lockfile; \
  elif [ -f yarn.lock ]; then corepack enable && yarn --frozen-lockfile; \
  elif [ -f package-lock.json ]; then npm ci; \
  else npm i; \
  fi

# Copy full application source code
COPY . .

# Ensure public directory exists to prevent copy failure in Stage 2
RUN mkdir -p public

# Build Next.js standalone bundle
RUN \
  if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm run build; \
  elif [ -f yarn.lock ]; then corepack enable && yarn run build; \
  else npm run build; \
  fi

# Stage 2: Hardened Unprivileged Next.js Standalone Runner
FROM ghcr.io/pfnapp/base/frameworks/nextjs:${NODE_VERSION}-alpine

WORKDIR /app

# Copy Next.js standalone output and assets with non-root ownership (UID 10001 / GID 10001)
COPY --from=builder --chown=10001:10001 /app/.next/standalone ./
COPY --from=builder --chown=10001:10001 /app/.next/static ./.next/static
COPY --from=builder --chown=10001:10001 /app/public ./public

# Unprivileged HTTP port
EXPOSE 8080

# Enforce non-root execution (UID 10001 / GID 10001)
USER 10001:10001
