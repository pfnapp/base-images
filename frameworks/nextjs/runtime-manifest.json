{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "runtime": "nextjs",
  "framework": "Next.js",
  "version": "15",
  "supportedFrameworkVersions": ["14", "15", "16"],
  "runtimeMatrix": {
    "nextjs-16": { "node": ["20", "22", "24"], "default": "22" },
    "nextjs-15": { "node": ["18", "20", "22"], "default": "22" },
    "nextjs-14": { "node": ["18", "20"], "default": "20" }
  },
  "baseImage": "ghcr.io/pfnapp/base/frameworks/nextjs:22-alpine",
  "ports": {
    "default": 8080,
    "protocol": "HTTP"
  },
  "security": {
    "runAsUser": 10001,
    "runAsGroup": 10001,
    "readOnlyRoot": false
  },
  "probes": {
    "liveness": { "path": "/", "port": 8080 },
    "readiness": { "path": "/", "port": 8080 }
  },
  "tunables": [
    {
      "key": "PORT",
      "label": "Server Port",
      "type": "number",
      "default": 8080,
      "category": "networking",
      "description": "Internal container listening port.",
      "troubleshooting": "Platform Next.js base image listens on unprivileged port 8080."
    },
    {
      "key": "NODE_ENV",
      "label": "Node Environment",
      "type": "string",
      "default": "production",
      "category": "runtime",
      "description": "Node.js execution environment mode.",
      "troubleshooting": "Keep set to 'production' for optimized build and runtime performance."
    },
    {
      "key": "NEXT_TELEMETRY_DISABLED",
      "label": "Disable Next.js Telemetry",
      "type": "string",
      "default": "1",
      "category": "runtime",
      "description": "Prevents Next.js from sending anonymous usage data to Vercel.",
      "troubleshooting": "Defaults to '1' for data privacy and network isolation."
    },
    {
      "key": "NODE_OPTIONS",
      "label": "Node Options",
      "type": "string",
      "default": "--max-old-space-size=512",
      "category": "performance",
      "description": "V8 engine runtime flags and max heap memory size.",
      "troubleshooting": "Increase --max-old-space-size for heavy SSR pages."
    }
  ]
}
